{
  "description": "Counterseal guard: holds irreversible shell commands and MCP tool calls until you approve them with a passkey",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs", "hook", "--agent", "claude-code"],
            "timeout": 660,
            "onFailure": "block",
            "statusMessage": "Counterseal guard"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs", "hook", "--agent", "claude-code"],
            "timeout": 660,
            "onFailure": "block",
            "statusMessage": "Counterseal guard"
          }
        ]
      }
    ]
  }
}
