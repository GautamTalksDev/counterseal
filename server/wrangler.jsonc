{
  // Counterseal (internal name: leash): control API (/v1/*), agent proxy (/p/*), the public receipts log and the site, one Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leash",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  // Two custom domains (wrangler adds the DNS records on deploy). counterseal.gautamkhosla.com is the product, the one
  // host. leash.gautamkhosla.com is retired: the Worker answers every request on it (pages, /app, /v1, /p, assets) with
  // a 301 to the same path on counterseal (src/index.js), so the route stays only for that redirect.
  "routes": [{ "pattern": "counterseal.gautamkhosla.com", "custom_domain": true }, { "pattern": "leash.gautamkhosla.com", "custom_domain": true }],
  // The Worker runs first for every request, so the retired host can redirect assets too; on counterseal it hands
  // everything that is not /v1, /p or /.well-known to the assets binding and adds the site's security headers.
  "assets": { "directory": "../site/public", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "leash", "database_id": "f275b6ea-aa0a-477a-a843-6caf89c74ca9", "migrations_dir": "migrations" }],
  // The public log: one SQLite-backed Durable Object (the only kind Workers Free allows).
  "durable_objects": { "bindings": [{ "name": "LOG", "class_name": "ReceiptLog" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReceiptLog"] }],
  // LOG_ORIGIN is signed into every checkpoint and can never change once the log has an entry (src/brand.js).
  // FREE_LIMIT: receipts per account per month. ACCOUNT_DAILY_CAP: per account per UTC day. GLOBAL_DAILY_CAP: appends
  // per UTC day across all accounts, sized for the Workers Free row budgets (docs/DEPLOY.md); REPORTED_DAILY_CAP: of those, the most
  // that agents may report through POST /v1/receipts (the broker's own decisions keep the rest). REG_PER_IP_DAY: sign-ups.
  // ORIGIN / RP_ID: the one host. WebAuthn ceremonies and CSRF checks accept exactly this origin and RP ID.
  "vars": { "RP_ID": "counterseal.gautamkhosla.com", "ORIGIN": "https://counterseal.gautamkhosla.com", "LOG_ORIGIN": "counterseal.gautamkhosla.com/log", "FREE_LIMIT": "10000", "ACCOUNT_DAILY_CAP": "2000", "GLOBAL_DAILY_CAP": "10000", "REPORTED_DAILY_CAP": "5000", "REG_PER_IP_DAY": "5" },
  // Secrets (wrangler secret put): LEASH_KEK (32 random bytes, base64url), IP_SALT, VAPID_PRIVATE_JWK (phone alerts:
  // node dev/vapid-keygen.mjs), LOG_KEY_JWK (the log's Ed25519 signing key: node dev/log-keygen.mjs).
  // Optional, replaces the in-memory read limiter: "ratelimits": [{ "name": "READ_LIMITER", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } }],
  // No cron: the account's five cron triggers are used. Cleanup runs inline on about 2% of requests and after sign-ins
  // (src/index.js sweep), after the response.
  "triggers": { "crons": [] },
  // Workers Logs off: Cloudflare stores no invocation or console logs for this Worker. Live `wrangler tail` still works.
  "observability": { "enabled": false }
}
